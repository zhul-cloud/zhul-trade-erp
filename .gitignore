# dependencies
**/node_modules

# backend build output
zhul-erp-backend/target/
**/*.class

# backend local/prod config (contains real local credentials, never commit)
zhul-erp-backend/src/main/resources/application-dev.yml
zhul-erp-backend/src/main/resources/application-prod.yml
.env
.env.*
!.env.example

# optional Docker bind mounts (all local runtime data stays under storage/)
/storage/*
!/storage/.gitkeep
# 本机开发专用的 Compose 覆盖文件（如 AI 订阅登录持久化），生产用 -f 指定文件，不读取它
/docker-compose.override.yaml

# frontend build output
zhul-erp-frontend/dist
zhul-erp-frontend/build
zhul-erp-frontend/src/.umi
zhul-erp-frontend/src/.umi-production
zhul-erp-frontend/src/.umi-test
zhul-erp-frontend/src/.umi-undefined
zhul-erp-frontend/.turbopack
zhul-erp-frontend/.wrangler
zhul-erp-frontend/coverage
zhul-erp-frontend/screenshot
zhul-erp-frontend/.firebase
zhul-erp-frontend/.worktrees
zhul-erp-frontend/.history
zhul-erp-frontend/yarn.lock

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# logs
*.log
npm-debug.log*
yarn-error.log

# local tool state (not project source)
.gstack/
.claude/settings.local.json
*bak
zhul-erp-backend/private-uploads/

# runtime uploads (local test attachments, never commit)
zhul-erp-backend/uploads/
