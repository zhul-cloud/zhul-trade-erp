# 本地开发配置模板。
# 复制为同目录下的 application-dev.yml（已在 .gitignore 中排除，不会被提交），
# 按需修改后即可覆盖 application.yml 中的默认值。
# 如果使用仓库根目录的 docker-compose.yml 启动依赖，下面的默认值无需修改。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/zhul_erp?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: root

  data:
    redis:
      host: localhost
      port: 6379
      password:

logging:
  level:
    com.zhul.erp: debug
