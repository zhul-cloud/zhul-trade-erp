                  "type": "text",
                  "id": "n13861",
                  "width": "fill_container",
                  "height": "fit_content",
                  "content": "点「确认」先弹出气泡二次确认，说明后果「确认后所有租户都能看到」（图中第 3 行）。",
                  "fontFamily": "Noto Sans SC",
                  "fontSize": 12.0,
                  "fontWeight": 400,
                  "letterSpacing": 0.0,
                  "lineHeight": 1.6,
                  "textGrowth": "fixed-width",
