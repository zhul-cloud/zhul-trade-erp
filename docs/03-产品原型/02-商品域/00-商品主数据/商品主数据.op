                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "n11402",
                  "width": "fill_container",
                  "height": "fit_content",
                  "content": "成功页不只说「保存成功」：先给正反馈（大勾），再把「下一步」变成 4 张小卡片，每张写明为什么值得做、大约多久。",
                  "fontFamily": "Noto Sans SC",
                  "fontSize": 12.0,
                  "fontWeight": 400,
                  "letterSpacing": 0.0,
                  "lineHeight": 1.6,
                  "textGrowth": "fixed-width",
                  "fill": [
