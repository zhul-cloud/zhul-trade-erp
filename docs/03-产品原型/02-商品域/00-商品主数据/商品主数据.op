                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "n11405",
                  "width": "fill_container",
                  "height": "fit_content",
                  "content": "完整度用 10 段进度条：一段对应档案里的一个模块，新人一眼知道离「完整」还差多少（图中已传图片，所以是 2/10）。",
                  "fontFamily": "Noto Sans SC",
                  "fontSize": 12.0,
                  "fontWeight": 400,
