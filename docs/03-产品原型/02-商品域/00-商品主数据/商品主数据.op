                    {
                      "type": "solid",
                      "color": "#B45309"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "n11132",
                  "width": "fill_container",
                  "height": "fit_content",
                  "content": "格式和大小限制直接写在拖放区下方，不等上传失败才提示；前端先预检，不合规立即说明原因。",
                  "fontFamily": "Noto Sans SC",
                  "fontSize": 12.0,
                  "fontWeight": 400,
