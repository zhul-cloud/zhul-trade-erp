                {
                  "type": "text",
                  "id": "n15454",
                  "width": "fill_container",
                  "height": "fit_content",
                  "content": "卡片仍是一级品类；卡片内列出它的细分品类，点标签可编辑，点「+ 细分品类」新增。",
                  "fontFamily": "Noto Sans SC",
                  "fontSize": 12.0,
                  "fontWeight": 400,
                  "lineHeight": 1.6,
                  "textGrowth": "fixed-width",
