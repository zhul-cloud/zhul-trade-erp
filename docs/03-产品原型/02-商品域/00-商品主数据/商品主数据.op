                      "type": "solid",
                      "color": "#B45309"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "n11281",
                  "width": "fill_container",
                  "height": "fit_content",
                  "content": "最后一步的主按钮写成「完成」，用动词告诉人点了会发生什么，而不是「下一步」。",
                  "fontFamily": "Noto Sans SC",
                  "fontSize": 12.0,
