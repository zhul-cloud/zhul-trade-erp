                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "n13858",
                  "width": "fill_container",
                  "height": "fit_content",
                  "content": "待审核行用暖色底和橙色描边突出，「确认」是唯一的主按钮；确认后描边变灰、标签变绿，并显示审核人和时间。",
                  "fontFamily": "Noto Sans SC",
                  "fontSize": 12.0,
                  "fontWeight": 400,
                  "letterSpacing": 0.0,
                  "lineHeight": 1.6,
                  "textGrowth": "fixed-width",
                  "fill": [
                    {
                      "type": "solid",
