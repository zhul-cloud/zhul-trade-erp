                }
              ]
            },
            {
              "type": "text",
              "id": "n755",
              "width": "fill_container",
              "height": "fit_content",
              "content": "选择国家后自动带出默认时区；美国、俄罗斯、巴西、澳大利亚等跨时区国家不带出，需手工选择。",
              "fontFamily": "Noto Sans SC",
              "fontSize": 12.0,
              "fontWeight": 400,
              "lineHeight": 1.6,
              "textGrowth": "fixed-width",
              "fill": [
