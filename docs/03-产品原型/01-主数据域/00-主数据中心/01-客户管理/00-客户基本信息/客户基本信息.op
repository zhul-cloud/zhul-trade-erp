                }
              ]
            },
            {
              "type": "text",
              "id": "n754",
              "width": "fill_container",
              "height": "fit_content",
              "content": "付款方式含「定金」时出现「定金比例（%）」且必填；选 L/C 远期、D/A、O/A 时出现「账期（天）」且必填（见编辑页）；其他付款方式两个字段都隐藏。",
              "fontFamily": "Noto Sans SC",
              "fontSize": 12.0,
              "fontWeight": 400,
              "lineHeight": 1.6,
              "textGrowth": "fixed-width",
              "fill": [
                {
