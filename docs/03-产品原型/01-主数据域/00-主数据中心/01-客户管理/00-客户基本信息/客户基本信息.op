                  "color": "#7A5B12"
                }
              ]
            },
            {
              "type": "text",
              "id": "n756",
              "width": "fill_container",
              "height": "fit_content",
              "content": "信用额度币种默认跟随默认币种。",
              "fontFamily": "Noto Sans SC",
              "fontSize": 12.0,
              "fontWeight": 400,
