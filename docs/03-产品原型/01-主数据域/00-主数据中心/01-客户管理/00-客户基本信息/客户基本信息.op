              "id": "n753",
              "width": "fill_container",
              "height": "fit_content",
              "content": "选了贸易术语，术语地点变为必填。",
              "fontFamily": "Noto Sans SC",
              "fontSize": 12.0,
              "fontWeight": 400,
              "lineHeight": 1.6,
              "textGrowth": "fixed-width",
