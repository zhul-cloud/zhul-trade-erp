                  ]
                },
                {
                  "type": "text",
                  "id": "n1002",
                  "width": "fill_container",
                  "height": "fit_content",
                  "content": "统计按首次接触日期归属；有效 = 曾进入 S3 及以后（之后输单仍计入有效）；有效率 = 有效 ÷ 新增。按业务员分组时第一列为业务员，按日期分组时为日期。",
                  "fontFamily": "Noto Sans SC",
                  "fontSize": 12.0,
                  "fontWeight": 400,
                  "textGrowth": "fixed-width",
                  "fill": [
                    {
                      "type": "solid",
                      "color": "#94A3B8"
                    }
                  ]
                }
              ]
