            },
            {
              "type": "text",
              "id": "n6397",
              "width": 1640.0,
              "height": "fit_content",
              "content": "· 后续采购、收款、出运流程与普通订单完全相同；客户付款照常在 PI 上传水单或由财务登记到账。",
              "fontFamily": "Noto Sans SC",
              "fontSize": 12.5,
              "lineHeight": 1.5,
              "textGrowth": "fixed-width",
              "fill": [
