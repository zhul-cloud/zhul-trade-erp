C"}]}, {"type": "text", "id": "n90", "width": "fit_content", "height": "fit_content", "content": "先处理下面的单据，再回来删除；或者改用「取消订单」", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#94A3B8"}]}]}, {"type": "frame", "id": "n91", "width": "fill_container", "layout": "vertical", "gap": 14.0, "padding": [4.0, 24.0, 20.0, 24.0], "children": [{"type": "frame", "id": "n92", "width": "fill_container", "layout": "vertical", "gap": 10.0, "padding": [14.0, 16.0], "cornerRadius": 10.0, "fill": [{"type": "solid", "color": "#2A1215"}], "children": [{"type": "text", "id": "n93", "width": "fit_content", "height": "fit_content", "content": "挡住删除的单据", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "fontWeight": 600, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#F05252"}]}, {"type": "frame", "id": "n94", "width": "fill_container", "layout": "horizontal", "gap": 8.0, "justifyContent": "space_between", "alignItems": "center", "children": [{"type": "frame", "id": "n95", "layout": "horizontal", "gap": 10.0, "alignItems": "center", "children": [{"type": "text", "id": "n96", "width": 72.0, "height": "fit_content", "content": "到账", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#94A3B8"}]}, {"type": "text", "id": "n97", "width": "fit_content", "height": "fit_content", "content": "RC20261111004 · USD 500.00", "fontFamily": "Noto Sans SC", "fontSize": 14.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#5B9BFF"}]}]}, {"type": "text", "id": "n98", "width": "fit_content", "height": "fit_content", "content": "先作废到账", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#CBD5E1"}]}]}, {"type": "frame", "id": "n99", "width": "fill_container", "layout": "horizontal", "gap": 8.0, "justifyContent": "space_between", "alignItems": "center", "children": [{"type": "frame", "id": "n100", "layout": "horizontal", "gap": 10.0, "alignItems": "center", "children": [{"type": "text", "id": "n101", "width": 72.0, "height": "fit_content", "content": "采购订单", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#94A3B8"}]}, {"type": "text", "id": "n102", "width": "fit_content", "height": "fit_content", "content": "PO20261111001 · 已下单", "fontFamily": "Noto Sans SC", "fontSize": 14.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#5B9BFF"}]}]}, {"type": "text", "id": "n103", "width": "fit_content", "height": "fit_content", "content": "先取消采购订单", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#CBD5E1"}]}]}, {"type": "frame", "id": "n104", "width": "fill_container", "layout": "horizontal", "gap": 8.0, "justifyContent": "space_between", "alignItems": "center", "children": [{"type": "frame", "id": "n105", "layout": "horizontal", "gap": 10.0, "alignItems": "center", "children": [{"type": "text", "id": "n106", "width": 72.0, "height": "fit_content", "content": "出库单", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#94A3B8"}]}, {"type": "text", "id": "n107", "width": "fit_content", "height": "fit_content", "content": "OB20261111002 · 待打包", "fontFamily": "Noto Sans SC", "fontSize": 14.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#5B9BFF"}]}]}, {"type": "text", "id": "n108", "width": "fit_content", "height": "fit_content", "content": "先撤回出库", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#CBD5E1"}]}]}]}]}, {"type": "frame", "id": "n109", "width": "fill_container", "layout": "horizontal", "gap": 10.0, "padding": [14.0, 24.0], "justifyContent": "end", "alignItems": "center", "stroke": {"thickness": 1.0, "align": "inside", "fill": [{"type": "solid", "color": "#22304A"}]}, "children": [{"type": "frame", "id": "n110", "height": 34.0, "layout": "horizontal", "gap": 6.0, "padding": [0.0, 14.0], "justifyContent": "center", "alignItems": "center", "cornerRadius": 8.0, "fill": [{"type": "solid", "color": "#3B82F6"}], "children": [{"type": "text", "id": "n111", "width": "fit_content", "height": "fit_content", "content": "知道了", "fontFamily": "Noto Sans SC", "fontSize": 14.0, "fontWeight": 600, "lineHeight": 1.5, "fill": [{"type": "solid", "color": "#17191D"}]}]}]}]}, {"type": "text", "id": "n112", "width": 920.0, "height": "fit_content", "content": "有到账、已向供应商下单、有出库或出运、售后退货、退款或余额抵扣、费用分摊、费用订单时不能删除，逐条列出并可点单号跳转；处理完再删。没有原因输入框和删除按钮。", "fontFamily": "Noto Sans SC", "fontSize": 13.0, "lineHeight": 1.6, "textAlign": "center", "textGrowth": "fixed-width", "fill": [{"type": "solid", "color": "#94A3B8"}]}]}]}], "children": [], "editorMeta": {"activePageIndex": 0, "preserveAuthoredGeometry": false}}