                    {
                      "type": "text",
                      "id": "n1491",
                      "width": "fill_container",
                      "height": "fit_content",
                      "content": "2–4 位大写字母，可以留空，不含连字符等符号（有些客户系统不支持）。只加在对外单据：报价单、PI、CI、PL、采购单、借项 / 贷项通知单、对账单；询盘、销售订单、发货批次等内部单据不加。修改前缀只影响之后新建的单据。",
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 12.0,
                      "fontWeight": 400,
                      "lineHeight": 1.6,
                      "textGrowth": "fixed-width",
                      "fill": [
