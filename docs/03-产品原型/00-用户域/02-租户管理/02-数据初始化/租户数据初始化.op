", "width": 14, "height": 14, "fill": [{"type": "solid", "color": "#4ADE80"}]}, {"type": "text", "id": "ti6", "width": 110, "height": "fit_content", "content": "岗位 18 个", "fontFamily": "Noto Sans SC", "fontSize": 13, "fontWeight": 600, "fill": [{"type": "solid", "color": "#F8FAFC"}], "textGrowth": "fixed-width"}, {"type": "text", "id": "ti7", "width": 440, "height": "fit_content", "content": "总经理、事业部合伙人、业务员、采购员、运营、供应链、会计、出纳等，带职责与对应角色", "fontFamily": "Noto Sans SC", "fontSize": 12, "fontWeight": 400, "fill": [{"type": "solid", "color": "#CBD5E1"}], "textGrowth": "fixed-width"}], "alignItems": "start"}, {"type": "frame", "id": "ti12", "width": "fill_container", "height": "fit_content", "layout": "horizontal", "gap": 10, "padding": [8, 0], "children": [{"type": "icon_font", "id": "ti9", "iconFontName": "check", "width": 14, "height": 14, "fill": [{"type": "solid", "color": "#4ADE80"}]}, {"type": "text", "id": "ti10", "width": 110, "height": "fit_content", "content": "角色 9 个", "fontFamily": "Noto Sans SC", "fontSize": 13, "fontWeight": 600, "fill": [{"type": "solid", "color": "#F8FAFC"}], "textGrowth": "fixed-width"}, {"type": "text", "id": "ti11", "width": 440, "height": "fit_content", "content": "总经理、财务、运营主管、运营专员、供应链主管、两个事业部合伙人（只看本事业部）、业务员、采购员，含菜单权限", "fontFamily": "Noto Sans SC", "fontSize": 12, "fontWeight": 400, "fill": [{"type": "solid", "color": "#CBD5E1"}], "textGrowth": "fixed-width"}], "alignItems": "start"}, {"type": "frame", "id": "ti16", "width": "fill_container", "height": "fit_content", "layout": "horizontal", "gap": 10, "padding": [8, 0], "children": [{"type": "icon_font", "id": "ti13", "iconFontName": "check", "width": 14, "height": 14, "fill": [{"type": "solid", "color": "#4ADE80"}]}, {"type": "text", "id": "ti14", "width": 110, "height": "fit_content", "content": "汇率", "fontFamily": "Noto Sans SC", "fontSize": 13, "fontWeight": 600, "fill": [{"type": "solid", "color": "#F8FAFC"}], "textGrowth": "fixed-width"}, {"type": "text", "id": "ti15", "width": 440, "height": "fit_content", "content": "租户还没有的币种按平台当前汇率写入初始值", "fontFamily": "Noto Sans SC", "fontSize": 12, "fontWeight": 400, "fill": [{"type": "solid", "color": "#CBD5E1"}], "textGrowth": "fixed-width"}], "alignItems": "start"}, {"type": "frame", "id": "ti20", "width": "fill_container", "height": "fit_content", "layout": "horizontal", "gap": 10, "padding": [8, 0], "children": [{"type": "icon_font", "id": "ti17", "iconFontName": "check", "width": 14, "height": 14, "fill": [{"type": "solid", "color": "#4ADE80"}]}, {"type": "text", "id": "ti18", "width": 110, "height": "fit_content", "content": "商品主数据", "fontFamily": "Noto Sans SC", "fontSize": 13, "fontWeight": 600, "fill": [{"type": "solid", "color": "#F8FAFC"}], "textGrowth": "fixed-width"}, {"type": "text", "id": "ti19", "width": 440, "height": "fit_content", "content": "不复制；按租户行业「工业控制」使用平台的品牌 92、品类 157、系列 513", "fontFamily": "Noto Sans SC", "fontSize": 12, "fontWeight": 400, "fill": [{"type": "solid", "color": "#CBD5E1"}], "textGrowth": "fixed-width"}], "alignItems": "start"}], "fill": [{"type": "solid", "color": "#0D1524"}], "cornerRadius": 10, "stroke": {"thickness": 1, "fill": [{"type": "solid", "color": "#1E293B"}]}}, {"type": "frame", "id": "ti25", "width": "fill_container", "height": "fit_content", "layout": "horizontal", "gap": 8, "padding": [10, 12], "children": [{"type": "icon_font", "id": "ti23", "iconFontName": "info", "width": 14, "height": 14, "fill": [{"type": "solid", "color": "#60A5FA"}]}, {"type": "text", "id": "ti24", "width": "fill_container", "height": "fit_content", "content": "可以重复执行，只补缺的：已有的部门、岗位、角色、汇率不改不删，角色的菜单权限不会被覆盖。", "fontFamily": "Noto Sans SC", "fontSize": 12, "fontWeight": 400, "fill": [{"type": "solid", "color": "#CBD5E1"}], "textGrowth": "fixed-width"}], "fill": [{"type": "solid", "color": "#182B4C"}], "cornerRadius": 10, "alignItems": "start"}, {"type": "frame", "id": "ti28", "width": "fill_container", "height": "fit_content", "layout": "horizontal", "gap": 8, "padding": [10, 