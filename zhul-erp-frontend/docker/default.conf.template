server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 210m;

    # Behind a reverse proxy on the host (or another container), restore the visitor IP from its
    # X-Real-IP so the backend logs the real client instead of the Docker gateway. Only the local
    # host and Docker networks are trusted; direct browser requests carry no such header.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 172.16.0.0/12;
    real_ip_header X-Real-IP;

    # Redirects such as /dashboard -> /dashboard/ must stay relative; the container
    # listens on 80 but is published on another host port (8000 by default).
    absolute_redirect off;

    # Resolve on requests, so an absent or recreated backend does not stop Nginx.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $backend_url "${BACKEND_URL}";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Keep the original prefix, query string, and upstream error responses.
    location ~ ^/(api|uploads)(/|$) {
        proxy_pass $backend_url$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_intercept_errors off;

        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Missing assets must return 404 instead of the SPA HTML document.
    location ~* \.(js|css|map|json|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot|wasm)$ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
