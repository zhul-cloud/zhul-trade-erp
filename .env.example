# =============================================================================
# 烛龙 ERP · Docker 部署配置模板
#
# 用法：复制为项目根目录的 .env（scripts/docker-dev 会自动生成），所有服务共用这一份。
#       不要另建 .env.dev 之类的副本，也不要提交 .env。
#
# 先看这几条：
#   1. 默认不持久化。数据库、Redis、上传文件都是临时存储，停止或重建容器就清空，
#      启动日志会打印警告。持久化没有环境变量开关，要改 docker-compose.yaml，
#      见 docs/06-部署运维/03-数据持久化与备份.md。
#   2. 启动后端前必须填写下面「必填」一节的三个密钥。
#   3. 用 AI 解析时填写 ANTHROPIC_API_KEY；只联调页面可把 AI_ORCHESTRATOR_MODE 改成 stub。
#   4. 改完后用 docker compose up -d <服务名> 重建容器才生效，restart 不会读取新值。
#   5. 值里有 $ 等特殊字符时用单引号包起来，例如 DB_PASSWORD='p$ss'。
#
# 只需要配置本机要启动的服务。启动哪些服务由 docker compose 命令决定，不要设置 COMPOSE_PROFILES。
# 本文件只给 Docker 容器用，本机直接运行的 Java 和前端不会读取它。
# 完整说明：docs/06-部署运维/README.md
# =============================================================================


# ----------------------------------------------------------------------------
# 必填：后端密钥
# 每项填一个不同的随机值。scripts/docker-dev 会自动生成；
# 手动生成见 docs/06-部署运维/02-配置说明.md。
# ----------------------------------------------------------------------------
# 登录令牌签名，至少 32 字符。更换后所有人需要重新登录。
JWT_SECRET=
# 敏感配置加密。已有数据后不要更换，否则已加密的配置无法解密。
AES_KEY=
# 后端与 AI 编排服务之间的回调令牌，两个服务共用这一个值。
AI_TASK_CALLBACK_TOKEN=


# ----------------------------------------------------------------------------
# AI 编排服务（询盘 AI 解析、型号描述翻译）
# 详见 docs/06-部署运维/04-AI编排服务.md
# ----------------------------------------------------------------------------
# api：调用 Anthropic API，按用量计费；stub：固定假数据，只用于页面联调，生产不要用。
AI_ORCHESTRATOR_MODE=api
# api 模式必填。为空时 AI 解析会直接失败并提示。
ANTHROPIC_API_KEY=
# 使用的模型，留空为 claude-opus-5-5。
AI_ORCHESTRATOR_MODEL=
# 单次解析最多联网搜索几次，用来控制费用。
AI_ORCHESTRATOR_MAX_WEB_SEARCHES=20
# 单次调用的最长等待时间（秒）。
AI_ORCHESTRATOR_TIMEOUT_SECONDS=900


# ----------------------------------------------------------------------------
# 文件存储
# local：存在后端容器的目录里（默认，体验和开发用）；oss：存阿里云 OSS（生产推荐）。
# 详见 docs/06-部署运维/07-对象存储.md
# ----------------------------------------------------------------------------
STORAGE_TYPE=local
# 以下为 oss 时必填（OSS_REGION、OSS_PUBLIC_DOMAIN、OSS_KEY_PREFIX 选填）。
# 填了地域时使用 V4 签名，例如 cn-hangzhou；Endpoint 例如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
OSS_REGION=
# 用只授权了下面两个存储桶的 RAM 子账号，不要用主账号密钥。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 私有存储桶：业务附件、凭证等，读写权限设为私有。
OSS_PRIVATE_BUCKET=
# 公开存储桶：共享商品库图片、登录页外观图片，读权限设为公共读。
OSS_PUBLIC_BUCKET=
# 公开存储桶绑定的自定义域名或 CDN，例如 https://static.example.com；留空用存储桶默认域名。
OSS_PUBLIC_DOMAIN=
# 多个环境共用存储桶时，用前缀区分，例如 prod、test。
OSS_KEY_PREFIX=


# ----------------------------------------------------------------------------
# 后端连接的数据库
# 默认连接本 Compose 里的 mysql、redis 容器；使用云服务时改成云实例的地址和账号。
# ----------------------------------------------------------------------------
# MySQL。DB_URL 非空时优先使用（可写云服务要求的 sslMode 等），否则由下面三项拼接。
DB_URL=
DB_HOST=mysql
DB_PORT=3306
DB_NAME=zhul_erp
# 默认的 root / root 只对应本地体验容器；生产和云服务改为实际应用账号。
DB_USER=root
DB_PASSWORD=root

# Redis。不使用 ACL 用户名时 REDIS_USERNAME 留空。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false


# ----------------------------------------------------------------------------
# 数据库初始化
# ----------------------------------------------------------------------------
# 默认只执行正式迁移，不创建任何登录账号。
# 仅本地体验时，在空库第一次启动后端前追加 ,classpath:db/dev-data 导入演示账号；生产不要追加。
FLYWAY_LOCATIONS=classpath:db/migration


# ----------------------------------------------------------------------------
# 访问入口与端口映射
# 格式：<绑定地址>:<宿主机端口>。127.0.0.1 表示只允许本机访问。
# ----------------------------------------------------------------------------
# 前端（浏览器访问入口）。
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8000
# 前端转发接口的后端地址。单机保持默认；分服务器写 http://后端服务器内网IP:8080，
# 只写协议、主机和端口，不加 /api、路径或末尾斜杠。
BACKEND_URL=http://backend:8080
# 后端。分服务器时改成本机内网 IP，并用防火墙限制来源。
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8080
# MySQL、Redis。本机开发时 Java 通过这些端口连接。
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379


# ----------------------------------------------------------------------------
# 本地 MySQL 容器初始化（只影响本 Compose 里的 mysql 容器，与上面的连接配置分开）
# 只在数据库第一次初始化时生效，之后修改不会改变已有的账号和密码。
# ----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=zhul_erp
# 可选：创建非 root 的应用账号。填写时同步修改上面的 DB_USER / DB_PASSWORD。
MYSQL_USER=
MYSQL_PASSWORD=


# ----------------------------------------------------------------------------
# 高级配置（一般不用改）
# ----------------------------------------------------------------------------
# 后端调用 AI 编排服务、编排服务回调后端的地址。两者在同一 Compose 里，保持默认即可。
AI_ORCHESTRATOR_BASE_URL=http://ai-orchestrator:8899
AI_TASK_CALLBACK_BASE_URL=http://backend:8080
# 后端启动时连接数据库的重试次数。
DB_CONNECT_RETRIES=12
# JVM 参数，如内存上限、云服务证书库。不要在这里放其他密钥。
JAVA_TOOL_OPTIONS=
