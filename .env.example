# 复制为项目根目录 .env。仅需配置本机将要启动的服务，不要提交实际凭据。
# 不设置 COMPOSE_PROFILES；启动范围由 docker compose 命令选择。
# .env 通过 Compose 显式映射到对应容器，不会自动配置本机启动的 Java。

# ---------- 前端 ----------
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8000
# 单机：http://backend:8080；分服务器：http://后端服务器内网IP:8080
# 只能含协议、主机及可选端口，不加 /api、路径、查询串或末尾斜杠。
BACKEND_URL=http://backend:8080

# ---------- 后端入口 ----------
# 分服务器时改成前端可达的本机内网IP，并配置网络准入。
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8080

# ---------- 后端连接的 MySQL（可指向云服务） ----------
# 非空完整 JDBC URL 优先于 DB_HOST/PORT/NAME，可配置云服务要求的 sslMode 等。
DB_URL=
DB_HOST=mysql
DB_PORT=3306
DB_NAME=zhul_erp
# 下面的默认账号仅匹配本地体验容器；云服务改为实际应用账号。
DB_USER=root
DB_PASSWORD=root

# ---------- 后端连接的 Redis（可指向云服务） ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false

# ---------- 后端密钥：启动后端前必须填写，不使用内置开发密钥 ----------
# 每项使用不同的随机值；JWT_SECRET 至少 32 字符。生成方法见部署文档。
JWT_SECRET=
AES_KEY=
AI_TASK_CALLBACK_TOKEN=

# ---------- 后端其他配置 ----------
# 默认只有正式迁移，不导入演示账号。仅本地体验可追加 ,classpath:db/dev-data。
FLYWAY_LOCATIONS=classpath:db/migration
DB_CONNECT_RETRIES=12
# JVM 内存或云服务 truststore 参数；不要把真实密钥作为构建参数。
JAVA_TOOL_OPTIONS=
# AI 编排服务属于已有外部依赖，本 Compose 不部署它；使用该功能时填写可达地址。
AI_ORCHESTRATOR_BASE_URL=http://host.docker.internal:8899
# 从 AI 编排服务所在网络可达的本项目后端地址，不能直接沿用 localhost。
AI_TASK_CALLBACK_BASE_URL=http://localhost:8080

# ---------- 本地 MySQL 容器初始化，与云服务连接参数分开 ----------
# 仅首次初始化生效。修改这里不会更改已有数据库里的密码或账号。
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=zhul_erp
# 可选：创建非 root 应用账号时同时填写，并同步 DB_USER/DB_PASSWORD。
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306

# ---------- 本地 Redis 容器 ----------
# 默认仅映射回环地址且无密码；REDIS_PASSWORD 只配置后端连接，不改变本地 Redis。
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379

# 持久化没有环境变量开关：在 docker-compose.yaml 中按注释切换 tmpfs 与 volumes。
# 数据统一写入项目根目录的 storage/ 下；默认 tmpfs 在停止/重启容器时清空。
